@@ -0,0 +1,23 @@
+import type { LowStockAlert, Product } from "./types.ts";
+import { now } from "./utils.ts";
+
+export const LOW_STOCK_THRESHOLD = 5;
+
+// @guide: In-memory log, oldest first, like carts and the catalog. This module must not import
+// @guide: products.ts (products.ts imports it), which is why each alert snapshots the product name.
+const alerts: LowStockAlert[] = [];
+
+export function recordLowStockAlert(product: Pick<Product, "id" | "name">, stock: number): void {
+  alerts.push({ productId: product.id, productName: product.name, stock, at: now() });
+}
+
+// @guide: Newest first by reversing insertion order, not by sorting on `at`: two alerts in the same
+// @guide: millisecond would otherwise have an undefined order (R9).
+export function listAlerts(): LowStockAlert[] {
+  return [...alerts].reverse();
+}
+
+/** Test helper: empties the log. */
+export function resetAlerts(): void {
+  alerts.length = 0;
+}
