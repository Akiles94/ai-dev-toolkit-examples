@@ -0,0 +1,19 @@
+import { LOW_STOCK_THRESHOLD } from "./alerts.ts";
+import { listProducts } from "./products.ts";
+import type { LowStockEntry } from "./types.ts";
+
+// @guide: A pure query over the current catalog, computed on every call. Nothing is stored, so a
+// @guide: restocked product disappears by itself (R10).
+export function lowStockProducts(): LowStockEntry[] {
+  return listProducts()
+    .filter((p) => p.stock < LOW_STOCK_THRESHOLD) // strictly below: 5 is not low (R1); 0 is (R2)
+    .map((p) => ({
+      id: p.id,
+      name: p.name,
+      stock: p.stock,
+      threshold: LOW_STOCK_THRESHOLD,
+      outOfStock: p.stock === 0,
+    }))
+    // @guide: Lowest stock first; ties by name so the order is stable (R8).
+    .sort((a, b) => a.stock - b.stock || a.name.localeCompare(b.name));
+}
